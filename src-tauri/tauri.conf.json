{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vut",
  "version": "0.1.0",
  "identifier": "olle.vut",
  "build": {
    "beforeDevCommand": "npm install && npm run dev",
    "beforeBuildCommand": "npm install && npm run build",
    "devUrl": "http://127.0.0.1:5187",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vut",
        "width": 640,
        "height": 76,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "therbbt",
    "copyright": "Copyright © 2026 therbbt",
    "shortDescription": "Very Useful Tool - a keyboard-driven launcher",
    "longDescription": "Vut is a cross-platform, keyboard-driven launcher in the spirit of Flow Launcher and AutoHotKey-style keyword launchers. Press a hotkey from anywhere to pop open a search bar and run user-defined commands: open a website, run a web search, or launch an application.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
